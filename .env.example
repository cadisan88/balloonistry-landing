# Copy this file to .env for local development. Never commit .env.
# These values are public and are read at build time.
# In production, set them as build variables in Workers Builds.

# Cloudflare Turnstile official test site key (always passes).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# PostHog. Leave the key empty in dev: analytics then does nothing.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
