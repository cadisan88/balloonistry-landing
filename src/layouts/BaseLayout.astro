---
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import defaultShareImage from '../assets/brand/og-default.jpg';
import ChannelSheet from '../components/ChannelSheet.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Toast from '../components/Toast.astro';
import { site } from '../config/site';
import type { PageType } from '../lib/analytics';
import type { ProductRef } from '../lib/channels';
import { localBusinessJsonLd, serializeJsonLd } from '../lib/seo';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  /** Page title without the site name. Leave empty on the home page. */
  title?: string;
  /** Meta description. Default: a short line about the business. */
  description?: string;
  pageType: PageType;
  /** Share image (Open Graph). Default: the brand image. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Open Graph type. */
  ogType?: 'website' | 'product';
  /** Structured data for this page. */
  jsonLd?: Record<string, unknown>[];
  /** Add the LocalBusiness structured data (home and contact pages). */
  business?: boolean;
  /** true when the page starts with a hero that sits under the transparent header. */
  hero?: boolean;
  /** false keeps the page out of search engines (404). */
  index?: boolean;
  /** The product of a product page. Pre-fills the messages in the channel sheet. */
  product?: ProductRef;
  /** Where "Order with the form" goes from the channel sheet. Default: the Contact page. */
  formHref?: string;
}

/** Home page title after the site name. Same wording as the old Wix site, to keep search rankings. */
const HOME_TITLE = 'Custom Balloons & Gifts Kitchener';

const DEFAULT_DESCRIPTION = `${site.name}: custom balloon gifts and event balloon decor in Kitchener-Waterloo, Ontario.`;

const {
  title,
  description = DEFAULT_DESCRIPTION,
  pageType,
  image,
  imageAlt,
  ogType = 'website',
  jsonLd = [],
  business = false,
  hero = false,
  index = true,
  product,
  formHref = '/contact/',
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${HOME_TITLE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Share image: a JPEG at a fixed size, with a full URL as social sites need
const share = image
  ? await getImage({ src: image, width: 1200, height: 1200, format: 'jpg', fit: 'cover' })
  : await getImage({ src: defaultShareImage, width: 1200, height: 630, format: 'jpg' });
const shareUrl = new URL(share.src, Astro.site).href;
const shareAlt = imageAlt ?? `${site.name}: ${site.tagline}`;
const structuredData = business ? [localBusinessJsonLd(shareUrl), ...jsonLd] : jsonLd;
---

<!doctype html>
<html lang={site.locale} class="no-js" data-page-type={pageType}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content={String(share.attributes.width)} />
    <meta property="og:image:height" content={String(share.attributes.height)} />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData.map((data) => (
      <script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />
    ))}
    <Font cssVariable="--font-fraunces" preload />
    <Font cssVariable="--font-nunito" preload />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" class:list={[{ 'page-top': !hero }]}>
      <slot />
    </main>
    <Footer />
    <ChannelSheet product={product} formHref={formHref} />
    <Toast />
    <script>
      import { initChannels } from '../scripts/channels';
      import { initReveal } from '../scripts/reveal';
      import { initTracking } from '../scripts/tracking';

      initReveal();
      initChannels();
      initTracking();
    </script>
  </body>
</html>
