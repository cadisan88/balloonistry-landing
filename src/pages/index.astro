---
import { getCollection } from 'astro:content';
import CategoryTiles from '../components/CategoryTiles.astro';
import ConnectSection from '../components/ConnectSection.astro';
import Confetti from '../components/Confetti.astro';
import EventGallery from '../components/EventGallery.astro';
import EventServices from '../components/EventServices.astro';
import Fringe from '../components/Fringe.astro';
import HomeHero from '../components/HomeHero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Lightbox from '../components/Lightbox.astro';
import ProductGrid from '../components/ProductGrid.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Testimonial from '../components/Testimonial.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedProducts, getVisibleCategories } from '../lib/content';

const [featured, categories, testimonials] = await Promise.all([
  getFeaturedProducts(),
  getVisibleCategories(),
  getCollection('testimonials'),
]);
const testimonial = testimonials.find((entry) => entry.data.featured);

const orderSteps = [
  { title: 'Pick your favourites', text: 'Browse the shop and choose the balloons you love.' },
  {
    title: 'Add them to your quote list',
    text: 'Add each one to your list, with the options you like.',
  },
  {
    title: 'Send the list',
    text: 'Send it on WhatsApp, Instagram, text or a call.',
  },
];
---

<BaseLayout
  pageType="home"
  business
  hero
  formHref="#contact"
  description="Custom balloon gifts, helium bouquets and event decor in Kitchener-Waterloo. Personalized balloons for birthdays, weddings, baby showers and more."
>
  <HomeHero />
  <Fringe />

  <!-- Featured products: cream ground, white cards -->
  <section class="section band band--cream" aria-labelledby="products-title">
    <div class="container">
      <div class="home-products__head">
        <SectionHeader eyebrow="Shop" title="Featured balloons" id="products-title" />
        <a class="btn btn-secondary" href="/shop/">
          See all products
        </a>
      </div>
      <ProductGrid products={featured} list="home_featured" zoomable />
    </div>
  </section>

  <!-- How ordering works: lavender-soft ground -->
  <section class="section band band--lavender-soft" aria-labelledby="how-title">
    <div class="container">
      <SectionHeader eyebrow="How ordering works" title="Three easy steps" id="how-title" />
      <HowItWorks steps={orderSteps} />
    </div>
  </section>

  <!-- Categories: cream -->
  <section class="section band band--cream" aria-labelledby="categories-title">
    <div class="container">
      <SectionHeader eyebrow="Browse" title="Shop by category" id="categories-title" />
      <CategoryTiles categories={categories} location="home" />
    </div>
  </section>

  <!-- Event decor teaser: turquoise-soft -->
  <section class="section band band--turquoise-soft" aria-labelledby="events-title">
    <div class="container">
      <SectionHeader
        eyebrow="Event decor"
        title="Event balloon design and installation"
        id="events-title"
      >
        <p>
          We design balloon decor for your celebration and install it at your venue. Tell us your
          date, colours and theme, and we will send you a design and a quote.
        </p>
      </SectionHeader>
      <EventGallery limit={3} />
      <div class="home-events__details">
        <EventServices />
        <div class="btn-row">
          <a class="btn btn-primary" href="/events/#quote" data-quote-cta data-location="home">
            Request a quote
          </a>
          <a class="btn btn-secondary" href="/events/">
            See event decor
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Corporate teaser: the one ink band of the page, white text -->
  <section class="section band-dark home-corporate" aria-labelledby="corporate-title">
    <Confetti variant="field" />
    <div class="container home-corporate__inner">
      <p class="eyebrow">Corporate</p>
      <h2 id="corporate-title">Balloon decor for corporate events</h2>
      <a class="btn btn-primary" href="/corporate/">
        See corporate decor
      </a>
    </div>
  </section>

  {testimonial && (
    <section class="section band band--white" aria-labelledby="love-title">
      <div class="container">
        <h2 class="home-love__title" id="love-title">
          Client love
        </h2>
        <Testimonial testimonial={testimonial} />
      </div>
    </section>
  )}

  <!-- Contact: lavender-soft, the fringe hangs above the footer from the footer itself -->
  <section class="section band band--lavender-soft" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <SectionHeader eyebrow="Contact" title="Connect with us" id="contact-title" />
      <ConnectSection idPrefix="home" />
    </div>
  </section>
  <Lightbox />
</BaseLayout>

<style>
  /* ----- Products: heading on the left, "See all" on the right ----- */

  .home-products__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .home-products__head :global(.section-header) {
    margin-bottom: 0;
  }

  /* ----- Event decor ----- */

  .home-events__details {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .home-events__details :global(.event-services) {
    margin-bottom: 0;
  }

  /* ----- Corporate band ----- */

  .home-corporate {
    overflow: hidden;
  }

  .home-corporate__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .home-corporate h2 {
    max-width: 16ch;
    margin-bottom: var(--space-5);
    font-size: var(--text-display-2);
    line-height: var(--leading-display);
  }

  /* ----- Client love ----- */

  /* Lines up with the quote text below it */
  .home-love__title {
    max-width: 48rem;
    margin: 0 auto var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-style: normal;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-crimson-deep);
  }
</style>
