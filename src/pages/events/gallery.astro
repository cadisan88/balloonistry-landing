---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Lightbox from '../../components/Lightbox.astro';
import MasonryGallery from '../../components/MasonryGallery.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEventsGallery } from '../../lib/content';
import { site } from '../../config/site';
import { breadcrumbJsonLd } from '../../lib/seo';

const eventGallery = await getEventsGallery();
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Events', path: '/events/' },
  { name: 'Gallery', path: '/events/gallery/' },
];
---

<BaseLayout
  title="Event Decor Gallery"
  description={`Photos of balloon arches, garlands, columns and event decor by ${site.name} in Kitchener-Waterloo.`}
  pageType="events"
  jsonLd={[breadcrumbJsonLd(crumbs)]}
>
  <section class="container gallery-page">
    <Breadcrumbs crumbs={crumbs} />
    <header class="page-head gallery-page__head">
      <h1>Event decor gallery</h1>
      <p class="lead">
        A look at the balloon decor we have designed and installed for celebrations.
      </p>
    </header>
    <MasonryGallery photos={eventGallery} group="events-gallery" label="Event decor photos" />
  </section>
  <Lightbox />
</BaseLayout>

<style>
  .gallery-page {
    padding-bottom: var(--section-pad);
  }

  .gallery-page__head {
    margin-top: var(--space-4);
  }

  .gallery-page__head h1 {
    max-width: none;
  }
</style>
