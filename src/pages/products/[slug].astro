---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ChannelLinks from '../../components/ChannelLinks.astro';
import ContactForm from '../../components/ContactForm.astro';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import ProductBuy from '../../components/ProductBuy.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import ProductMedia from '../../components/ProductMedia.astro';
import ProductTags from '../../components/ProductTags.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAvailableProducts,
  getCategoriesOf,
  getProductInfo,
  getRelatedProducts,
  type Product,
} from '../../lib/content';
import { buildMessage } from '../../lib/channels';
import { formatPrice } from '../../lib/price';
import { absoluteUrl, breadcrumbJsonLd, describe, productJsonLd } from '../../lib/seo';

// Products with `available: false` get no page.
export const getStaticPaths = (async () => {
  const products = await getAvailableProducts();
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}) satisfies GetStaticPaths;

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, price, tags, images, imageAlt, videos, options, features } = product.data;
const { Content } = await render(product);
const [categories, related, info] = await Promise.all([
  getCategoriesOf(product),
  getRelatedProducts(product),
  getProductInfo(),
]);
const productRef = { id: product.id, name };
const ORDER_FORM_ID = 'order-form';

// Search and share data. The owner's description is used once it is no longer a TODO.
const [mainImage] = images;
const firstParagraph = (product.body ?? '')
  .trim()
  .split(/\n\s*\n/)[0]
  ?.replace(/\s+/g, ' ');
const description = describe(
  firstParagraph && firstParagraph.length > 160
    ? `${firstParagraph.slice(0, 157)}...`
    : firstParagraph,
  `${name}, ${formatPrice(price)}. A custom balloon gift from Balloonistry in Kitchener-Waterloo. Order by form, WhatsApp, text or phone.`,
);
const shareImage = mainImage
  ? await getImage({ src: mainImage, width: 1200, height: 1200, format: 'jpg', fit: 'cover' })
  : undefined;
// A small image for the quote list
const thumb = mainImage
  ? await getImage({ src: mainImage, width: 160, height: 160, format: 'webp', fit: 'cover' })
  : undefined;

// The same crumbs for the visible breadcrumbs and the JSON-LD
const [firstCategory] = categories;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Shop', path: '/shop/' },
  ...(firstCategory ? [{ name: firstCategory.data.name, path: `/shop/${firstCategory.id}/` }] : []),
  { name, path: `/products/${product.id}/` },
];
const jsonLd = [
  productJsonLd({
    id: product.id,
    name,
    description,
    imageUrl: shareImage ? absoluteUrl(shareImage.src) : '',
    price,
  }),
  breadcrumbJsonLd(crumbs),
];
---

<BaseLayout
  title={name}
  description={description}
  pageType="product"
  image={mainImage}
  imageAlt={imageAlt ?? name}
  ogType="product"
  jsonLd={jsonLd}
  product={productRef}
  formHref={`#${ORDER_FORM_ID}`}
>
  <div class="container product-crumbs">
    <Breadcrumbs crumbs={crumbs} />
  </div>

  <article
    class="container product"
    data-product-page
    data-product={product.id}
    data-price={price}
    data-categories={categories.map((category) => category.id).join(',')}
  >
    <ProductMedia productId={product.id} alt={imageAlt ?? name} images={images} videos={videos} />

    <div class="product__info">
      <ProductTags tags={tags} addons={options.length > 0} />
      <h1 class="product__name">{name}</h1>
      <ProductBuy product={product} image={thumb?.src}>
        {firstParagraph && <p class="product__intro">{firstParagraph}</p>}
      </ProductBuy>

      <div class="folds">
        <details class="fold" open>
          <summary class="fold__summary">
            <h2 class="fold__title">Description</h2>
            <span class="fold__chevron" aria-hidden="true">
              <Icon name="chevron-down" size={24} />
            </span>
          </summary>
          <div class="fold__body">
            <div class="prose">
              <Content />
            </div>
          </div>
        </details>

        {features.length > 0 && (
          <details class="fold">
            <summary class="fold__summary">
              <h2 class="fold__title">Features</h2>
              <span class="fold__chevron" aria-hidden="true">
                <Icon name="chevron-down" size={24} />
              </span>
            </summary>
            <div class="fold__body">
              <ul class="fold__list">
                {features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
            </div>
          </details>
        )}

        <details class="fold">
          <summary class="fold__summary">
            <h2 class="fold__title">Shipping &amp; delivery</h2>
            <span class="fold__chevron" aria-hidden="true">
              <Icon name="chevron-down" size={24} />
            </span>
          </summary>
          <div class="fold__body">
            <p>{info.shipping}</p>
            <a class="link-draw" href="/policies/shipping-pickup/">
              Read the shipping and pickup policy
            </a>
          </div>
        </details>

        <details class="fold">
          <summary class="fold__summary">
            <h2 class="fold__title">Returns &amp; refunds</h2>
            <span class="fold__chevron" aria-hidden="true">
              <Icon name="chevron-down" size={24} />
            </span>
          </summary>
          <div class="fold__body">
            <p>{info.returns}</p>
            <a class="link-draw" href="/policies/refund-cancellation/">
              Read the refund and cancellation policy
            </a>
          </div>
        </details>
      </div>
    </div>
  </article>

  <div class="container product-details">
    {categories.length > 0 && (
      <section aria-labelledby="categories-title">
        <h2 id="categories-title">Categories</h2>
        <ul class="product-details__chips">
          {categories.map((category) => (
            <li>
              <a class="chip" href={`/shop/${category.id}/`}>
                {category.data.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <section class="container order-form" id={ORDER_FORM_ID} aria-labelledby="order-form-title">
    <h2 id="order-form-title">Prefer to order another way?</h2>
    <p>Chat with us, or send your request with the form. Your message is ready below.</p>
    <div class="order-form__channels">
      <ChannelLinks location="product_panel" product={productRef} />
    </div>
    <ContactForm
      type="order"
      idPrefix="order"
      product={productRef}
      message={buildMessage(productRef)}
      location="product_panel"
    />
  </section>

  {related.length > 0 && (
    <section class="container section related">
      <h2>You may also like</h2>
      <ProductGrid products={related} list="related" />
    </section>
  )}

  <Lightbox />
</BaseLayout>

<style>
  .product-crumbs {
    padding-bottom: var(--space-2);
  }

  .product {
    display: grid;
    gap: var(--space-6);
    padding-bottom: var(--space-7);
  }

  @media (min-width: 860px) {
    .product {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .product__info {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .product__info > :global(*) {
    margin-block: 0;
  }

  /* The tag stickers on the product page sit perfectly level (the tilt stays on cards).
     Set through the variable: the build's CSS minifier drops a plain `rotate` override here. */
  .product__info {
    --sticker-tilt: 0deg;
  }

  .product__name {
    font-size: var(--text-h2);
  }

  .product__intro {
    font-size: var(--text-lead);
  }

  /* ----- Description, features, shipping, returns: native <details> ----- */

  .folds {
    margin-top: var(--space-2);
    border-top: 2px solid var(--color-border);
  }

  .fold {
    border-bottom: 2px solid var(--color-border);
  }

  .fold__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;
    cursor: pointer;
    list-style: none;
  }

  .fold__summary::-webkit-details-marker {
    display: none;
  }

  .fold__summary:focus-visible {
    outline: 3px solid var(--color-ink);
    outline-offset: 2px;
  }

  .fold__title {
    margin: 0;
    font-size: var(--text-h3);
    font-style: normal;
    letter-spacing: 0;
  }

  .fold__chevron {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-ink);
  }

  .fold[open] .fold__chevron {
    transform: rotate(180deg);
  }

  .fold__body {
    padding-bottom: var(--space-5);
  }

  .fold__body > :first-child {
    margin-top: 0;
  }

  .fold__body p {
    max-width: var(--measure);
  }

  .fold__body a.link-draw {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  .fold__list {
    max-width: var(--measure);
    margin: 0;
  }

  .fold__list li + li {
    margin-top: var(--space-2);
  }

  /* Smooth open and close where the browser supports it. Without it the section just opens. */
  @media (prefers-reduced-motion: no-preference) {
    .fold__chevron {
      transition: transform var(--duration-hover) var(--ease);
    }

    @supports (interpolate-size: allow-keywords) {
      .fold {
        interpolate-size: allow-keywords;
      }

      .fold::details-content {
        block-size: 0;
        overflow: clip;
        transition:
          block-size var(--duration-hover) var(--ease),
          content-visibility var(--duration-hover) var(--ease) allow-discrete;
      }

      .fold[open]::details-content {
        block-size: auto;
      }
    }
  }

  /* ----- Categories ----- */

  .product-details {
    padding-bottom: var(--space-7);
  }

  .product-details h2 {
    font-size: var(--text-h3);
    font-style: normal;
    letter-spacing: 0;
  }

  .product-details__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ----- Order form (secondary path) ----- */

  .order-form {
    max-width: 52rem;
    padding-bottom: var(--space-7);
  }

  .order-form__channels {
    margin-bottom: var(--space-6);
  }

  .related {
    padding-top: var(--space-7);
  }
</style>

<style is:global>
  /* Phones: the breadcrumbs sit close under the header */
  @media (max-width: 599px) {
    main.page-top {
      padding-top: calc(var(--header-height) + var(--space-2));
    }
  }
</style>
