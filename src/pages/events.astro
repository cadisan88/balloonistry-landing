---
import { Picture } from 'astro:assets';
import ChannelLinks from '../components/ChannelLinks.astro';
import Confetti from '../components/Confetti.astro';
import ContactForm from '../components/ContactForm.astro';
import EventGallery from '../components/EventGallery.astro';
import EventServices from '../components/EventServices.astro';
import Fringe from '../components/Fringe.astro';
import HowItWorks from '../components/HowItWorks.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { eventGallery } from '../config/events';
import { site } from '../config/site';

const QUOTE_ID = 'quote';
const heroPhoto = eventGallery[0];
const steps = [
  { title: 'Tell us about your event' },
  { title: 'We send a design and quote' },
  { title: 'We deliver and install' },
];
---

<BaseLayout
  title="Event Decor"
  description={`Event balloon design and installation by ${site.name}: arches, garlands, columns and outdoor decor in Kitchener-Waterloo.`}
  pageType="events"
  hero
  formHref={`#${QUOTE_ID}`}
>
  <section class="band band--cream events-hero" aria-labelledby="events-title">
    <div class="container events-hero__grid">
      <div class="events-hero__text">
        <p class="eyebrow enter">Event decor</p>
        <h1 id="events-title" class="enter enter-d1">
          Event balloon design and installation
        </h1>
        <p class="lead enter enter-d2">
          We design balloon decor for your celebration and install it at your venue. Tell us your
          date, colours and theme, and we will send you a design and a quote.
        </p>
        <div class="btn-row enter enter-d3">
          <a
            class="btn btn-primary"
            href={`#${QUOTE_ID}`}
            data-form-link
            data-quote-cta
            data-location="events"
          >
            Request a quote
          </a>
        </div>
      </div>
      {heroPhoto && (
        <div class="events-hero__frame">
          <Confetti variant="frame" />
          <div class="events-hero__media enter-scale enter-d2">
            <Picture
              src={heroPhoto.image}
              alt={heroPhoto.alt}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1180px) 460px, (min-width: 860px) 40vw, 80vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      )}
    </div>
  </section>
  <Fringe />

  <section class="section band band--turquoise-soft" aria-labelledby="services-title">
    <div class="container">
      <SectionHeader
        eyebrow="Services"
        title="Balloon decor for every celebration"
        id="services-title"
      />
      <EventServices />
      <EventGallery />
    </div>
  </section>

  <section class="section band band--white" aria-labelledby="steps-title">
    <div class="container">
      <SectionHeader eyebrow="How it works" title="Three simple steps" id="steps-title" />
      <HowItWorks steps={steps} />
    </div>
  </section>

  <section class="section band band--lavender-soft" id={QUOTE_ID} aria-labelledby="quote-title">
    <div class="container container--narrow">
      <SectionHeader eyebrow="Get a quote" title="Request a quote" id="quote-title">
        <p>
          Tell us about your event. The date, type and city help us plan, but they are optional.
        </p>
      </SectionHeader>
      <div class="events-quote__panel">
        <ContactForm type="event_quote" idPrefix="quote" location="events" />
      </div>

      <div class="events-quote__channels">
        <h3>Prefer to chat?</h3>
        <ChannelLinks location="events" intent="contact" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .events-hero {
    overflow-x: clip;
    padding-block: var(--space-7) calc(var(--section-pad) + var(--fringe-tooth));
  }

  .events-hero__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 860px) {
    .events-hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--space-7);
    }
  }

  .events-hero__text h1 {
    max-width: 12ch;
    margin-bottom: var(--space-5);
  }

  .events-hero__text .lead {
    max-width: 46ch;
    margin-bottom: var(--space-6);
  }

  .events-hero__frame {
    position: relative;
    width: min(100%, 28rem);
    margin-inline: auto;
  }

  .events-hero__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    background: var(--color-lavender);
    transform: translate(var(--space-4), var(--space-4)) rotate(2deg);
  }

  .events-hero__media {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-lavender-soft);
    box-shadow: var(--shadow-lg);
  }

  .events-hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .events-quote__panel {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 600px) {
    .events-quote__panel {
      padding: var(--space-6);
    }
  }

  .events-quote__channels {
    margin-top: var(--space-7);
  }
</style>
