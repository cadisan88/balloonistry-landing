---
import { getCollection, render } from 'astro:content';
import ChannelLinks from '../components/ChannelLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FAQ_GROUP_TITLES, FAQ_GROUPS } from '../lib/faq';
import { sortByOrder } from '../lib/catalog';
import { faqJsonLd } from '../lib/seo';

const entries = await getCollection('faq');
// Sort by order, then by question (sortByOrder sorts by `name`)
const sorted = sortByOrder(
  entries.map((entry) => ({ entry, data: { name: entry.data.question, order: entry.data.order } })),
).map(({ entry }) => entry);

const groups = await Promise.all(
  FAQ_GROUPS.map(async (group) => ({
    group,
    title: FAQ_GROUP_TITLES[group],
    items: await Promise.all(
      sorted
        .filter((entry) => entry.data.group === group)
        .map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
    ),
  })),
).then((list) => list.filter(({ items }) => items.length > 0));

const structured = faqJsonLd(
  sorted.map((entry) => ({ question: entry.data.question, answer: entry.body ?? '' })),
);
---

<BaseLayout
  title="FAQ"
  description="Answers to common questions about ordering, delivery and pickup, products, events and payment at Balloonistry."
  pageType="faq"
  jsonLd={structured ? [structured] : []}
>
  <section class="container container--narrow faq">
    <header class="page-head">
      <p class="eyebrow">FAQ</p>
      <h1>Frequently asked questions</h1>
    </header>

    <!-- Needs JavaScript: hidden without it, and then every question shows -->
    <div class="faq__search" role="search">
      <label class="faq__search-label" for="faq-search">
        Search questions
      </label>
      <input
        class="faq__search-input"
        id="faq-search"
        type="search"
        autocomplete="off"
        data-faq-input
      />
      <p class="visually-hidden" role="status" aria-live="polite" data-faq-status></p>
    </div>

    <div class="faq__empty" data-faq-empty hidden>
      <p>
        No questions match �<span data-faq-empty-query></span>�.
        <button class="faq__clear" type="button" data-faq-clear>
          Clear search
        </button>
      </p>
    </div>

    {groups.map(({ group, title, items }) => (
      <section class="faq__group" aria-labelledby={`faq-${group}`} data-faq-group>
        <h2 id={`faq-${group}`}>{title}</h2>
        {items.map(({ entry, Content }) => (
          <details class="faq__item" data-faq-item>
            <summary>{entry.data.question}</summary>
            <div class="faq__answer prose">
              <Content />
            </div>
          </details>
        ))}
      </section>
    ))}

    <aside class="faq__more" aria-labelledby="faq-more-title">
      <h2 id="faq-more-title">Still have a question?</h2>
      <p>Message, text or call us. We are happy to help.</p>
      <ChannelLinks location="contact_section" intent="contact" formHref="/contact/" />
    </aside>
  </section>
</BaseLayout>

<script>
  import { initFaqSearch } from '../scripts/faq-search';

  initFaqSearch();
</script>

<style>
  .faq {
    padding-bottom: var(--section-pad);
  }

  .faq__search {
    display: none;
    margin-bottom: var(--space-6);
  }

  :global(.js) .faq__search {
    display: block;
  }

  .faq__search-label {
    display: block;
    margin-bottom: var(--space-2);
    font-weight: 700;
  }

  .faq__search-input {
    width: 100%;
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    color: var(--color-ink);
    font: inherit;
  }

  .faq__empty {
    margin-bottom: var(--space-6);
    padding: var(--space-5);
    border-radius: var(--radius);
    background: var(--color-white);
  }

  .faq__empty p {
    margin: 0;
  }

  .faq__empty[hidden],
  .faq__group[hidden],
  .faq__item[hidden] {
    display: none;
  }

  .faq__clear {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-crimson-deep);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }

  .faq__group + .faq__group {
    margin-top: var(--space-8);
  }

  .faq__group h2 {
    margin-bottom: var(--space-4);
    font-size: var(--text-h2);
  }

  /* Each question is a crisp white card */
  .faq__item {
    margin-bottom: var(--space-3);
    border: 2px solid transparent;
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--duration-hover) var(--ease);
  }

  .faq__item[open] {
    border-color: var(--color-ink);
  }

  .faq__item summary {
    position: relative;
    padding: var(--space-4) var(--space-8) var(--space-4) var(--space-5);
    border-radius: var(--radius);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  /* A plus sign that turns into a minus when open */
  .faq__item summary::after {
    content: '+';
    position: absolute;
    top: 50%;
    right: var(--space-5);
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-crimson-deep);
    transform: translateY(-50%);
  }

  .faq__item[open] summary::after {
    content: '\2212';
  }

  .faq__answer {
    padding: 0 var(--space-5) var(--space-5);
  }

  .faq__more {
    margin-top: var(--space-8);
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-lavender-soft);
  }

  .faq__more h2 {
    font-size: var(--text-h2);
  }
</style>
