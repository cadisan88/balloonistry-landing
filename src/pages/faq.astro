---
import { getCollection, render } from 'astro:content';
import ChannelLinks from '../components/ChannelLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FAQ_GROUP_TITLES, FAQ_GROUPS } from '../lib/faq';
import { sortByOrder } from '../lib/catalog';
import { faqJsonLd } from '../lib/seo';

const entries = await getCollection('faq');
// Sort by order, then by question (sortByOrder sorts by `name`)
const sorted = sortByOrder(
  entries.map((entry) => ({ entry, data: { name: entry.data.question, order: entry.data.order } })),
).map(({ entry }) => entry);

const groups = await Promise.all(
  FAQ_GROUPS.map(async (group) => ({
    group,
    title: FAQ_GROUP_TITLES[group],
    items: await Promise.all(
      sorted
        .filter((entry) => entry.data.group === group)
        .map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
    ),
  })),
).then((list) => list.filter(({ items }) => items.length > 0));

const structured = faqJsonLd(
  sorted.map((entry) => ({ question: entry.data.question, answer: entry.body ?? '' })),
);
---

<BaseLayout
  title="FAQ"
  description="Answers to common questions about ordering, delivery and pickup, products, events and payment at Balloonistry."
  pageType="faq"
  jsonLd={structured ? [structured] : []}
>
  <section class="container faq">
    <header class="faq__header">
      <p class="eyebrow">FAQ</p>
      <h1>Frequently asked questions</h1>
    </header>

    {groups.map(({ group, title, items }) => (
      <section class="faq__group" aria-labelledby={`faq-${group}`}>
        <h2 id={`faq-${group}`}>{title}</h2>
        {items.map(({ entry, Content }) => (
          <details class="faq__item">
            <summary>{entry.data.question}</summary>
            <div class="faq__answer prose">
              <Content />
            </div>
          </details>
        ))}
      </section>
    ))}

    <aside class="faq__more" aria-labelledby="faq-more-title">
      <h2 id="faq-more-title">Still have a question?</h2>
      <p>Message, text or call us. We are happy to help.</p>
      <ChannelLinks location="contact_section" intent="contact" formHref="/contact/" />
    </aside>
  </section>
</BaseLayout>

<style>
  .faq {
    max-width: 52rem;
    padding-bottom: var(--section-pad);
  }

  .faq__header {
    margin-bottom: var(--space-7);
  }

  .faq__group + .faq__group {
    margin-top: var(--space-7);
  }

  .faq__group h2 {
    font-size: var(--text-h3);
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__item summary {
    position: relative;
    padding: var(--space-4) var(--space-7) var(--space-4) 0;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  /* A plus sign that turns into a minus when open */
  .faq__item summary::after {
    content: '+';
    position: absolute;
    top: 50%;
    right: var(--space-2);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-crimson-deep);
    transform: translateY(-50%);
  }

  .faq__item[open] summary::after {
    content: '\2212';
  }

  .faq__answer {
    padding-bottom: var(--space-5);
  }

  .faq__more {
    margin-top: var(--space-8);
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius);
    background: var(--color-lavender-soft);
  }

  .faq__more h2 {
    font-size: var(--text-h3);
  }
</style>
