---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { describe } from '../lib/seo';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('src/content/pages/about.md is missing');
const { Content } = await render(about);
const description = describe(
  about.data.description,
  'About Balloonistry, a balloon gift and event decor business in Kitchener-Waterloo, Ontario.',
);
---

<BaseLayout title={about.data.title} description={description} pageType="about">
  <article class="container container--narrow text-page">
    <header class="page-head">
      <p class="eyebrow">About</p>
      <h1>{about.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="text-page__cta">
      <a class="btn btn-primary" href="/shop/">
        Shop balloons
      </a>
    </p>
  </article>
</BaseLayout>

<style>
  .text-page__cta {
    margin-top: var(--space-7);
  }
</style>
