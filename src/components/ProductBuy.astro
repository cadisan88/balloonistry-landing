---
/**
 * The buy box of a product page: price, intro (slot), options, quantity and the two buttons.
 * Behaviour: src/scripts/product-options.ts. Without JavaScript the options show, the price
 * is the base price, "Add to quote list" is hidden and "Ask on WhatsApp" sends the base message.
 */
import Icon from './Icon.astro';
import type { Product } from '../lib/content';
import { buildMessage, whatsappLink } from '../lib/channels';
import { formatAmount, formatPrice } from '../lib/price';

interface Props {
  product: Product;
  /** Small image for the quote list (URL path). */
  image?: string | undefined;
}

const { product, image } = Astro.props;
const { name, price, options } = product.data;
const url = `/products/${product.id}/`;
const message = buildMessage({ id: product.id, name });
---

<div class="buy" data-buy data-base-price={price} data-base-message={message}>
  <p class="buy__price" aria-live="polite" aria-atomic="true" data-buy-price>
    {formatPrice(price)}
  </p>

  <slot />

  {options.length > 0 && (
    <div class="buy__options">
      <h2 class="buy__options-title">Options</h2>
      {options.map((group, groupIndex) => (
        <fieldset class="buy__group">
          <legend>
            {group.name}
            {group.type === 'multiple' && <span class="buy__hint">(choose any)</span>}
          </legend>
          <div class="buy__choices">
            {group.choices.map((choice, choiceIndex) => (
              <label class="buy__choice">
                <input
                  type={group.type === 'single' ? 'radio' : 'checkbox'}
                  name={`option-${groupIndex}`}
                  value={choice.label}
                  checked={group.type === 'single' && choiceIndex === 0}
                  data-option-input
                  data-group={group.name}
                  data-choice={choice.label}
                  data-price={choice.price}
                />
                <span class="buy__choice-label">{choice.label}</span>
                {choice.price > 0 && (
                  <span class="buy__choice-price">+{formatAmount(choice.price)}</span>
                )}
              </label>
            ))}
          </div>
        </fieldset>
      ))}
    </div>
  )}

  <div class="buy__qty">
    <label for="buy-qty">Quantity</label>
    <div class="stepper">
      <button class="stepper__btn" type="button" data-buy-step="-1">
        <Icon name="minus" size={18} />
        <span class="visually-hidden">Decrease quantity</span>
      </button>
      <input
        class="stepper__input"
        id="buy-qty"
        type="number"
        min="1"
        max="20"
        value="1"
        inputmode="numeric"
        data-buy-qty
      />
      <button class="stepper__btn" type="button" data-buy-step="1">
        <Icon name="plus" size={18} />
        <span class="visually-hidden">Increase quantity</span>
      </button>
    </div>
  </div>

  <div class="buy__actions">
    <button
      class="btn btn-primary buy__add"
      type="button"
      data-quote-add
      data-product={product.id}
      data-product-name={name}
      data-product-url={url}
      data-product-image={image}
      data-base-price={price}
      data-qty="1"
      data-options="0"
      data-unit-price={price}
      data-quote-location="product_page"
      data-quote-options="[]"
    >
      <Icon name="clipboard-list" size={22} />
      Add to quote list
    </button>
    <a
      class="btn btn-channel btn-channel--whatsapp"
      href={whatsappLink(message)}
      target="_blank"
      rel="noopener"
      data-buy-ask
      data-channel="whatsapp"
      data-channel-location="product_panel"
      data-product={product.id}
    >
      <Icon name="whatsapp" size={24} />
      Ask on WhatsApp
      <span class="visually-hidden">(opens in a new tab)</span>
    </a>
  </div>
</div>

<script>
  import { initProductOptions } from '../scripts/product-options';

  initProductOptions();
</script>

<style>
  .buy {
    display: grid;
    gap: var(--space-5);
  }

  .buy > :global(*) {
    margin-block: 0;
  }

  .buy__price {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-crimson-deep);
  }

  .buy__options {
    display: grid;
    gap: var(--space-4);
  }

  .buy__options-title {
    margin: 0;
    font-size: var(--text-h3);
    font-style: normal;
    letter-spacing: 0;
  }

  .buy__group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .buy__group legend {
    margin-bottom: var(--space-2);
    padding: 0;
    font-weight: 800;
  }

  .buy__hint {
    margin-left: var(--space-2);
    font-size: var(--text-small);
    font-weight: 400;
  }

  .buy__choices {
    display: grid;
    gap: var(--space-2);
  }

  .buy__choice {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    font-weight: 700;
    cursor: pointer;
    transition:
      border-color var(--duration-hover) var(--ease),
      background-color var(--duration-hover) var(--ease);
  }

  .buy__choice:hover {
    border-color: var(--color-border-strong);
  }

  .buy__choice:has(input:checked) {
    border-color: var(--color-ink);
    background: var(--color-lavender-soft);
  }

  .buy__choice:has(input:focus-visible) {
    outline: 3px solid var(--color-ink);
    outline-offset: 2px;
  }

  .buy__choice input {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--color-ink);
  }

  .buy__choice-label {
    flex: 1;
  }

  .buy__choice-price {
    color: var(--color-crimson-deep);
  }

  .buy__qty {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }

  .buy__qty label {
    font-weight: 800;
  }

  .buy__actions {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 600px) {
    .buy__actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .buy__actions .btn {
    width: 100%;
  }

  /* Needs JavaScript: the list, the quantity and the live price */
  :global(.no-js) .buy__add,
  :global(.no-js) .buy__qty {
    display: none;
  }
</style>
