---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  /** Describes the product. Photo 2 and later add "photo N". */
  alt: string;
}

const { images, alt } = Astro.props;
const hasThumbnails = images.length > 1;
---

<div class="gallery" data-gallery>
  <div class="gallery__stage zoom-out">
    {images.map((image, index) => (
      <div class:list={['gallery__slide', { 'is-active': index === 0 }]} data-gallery-slide>
        <Picture
          src={image}
          alt={index === 0 ? alt : `${alt}, photo ${index + 1}`}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1180px) 560px, (min-width: 860px) 48vw, 100vw"
          width={1200}
          height={1200}
          /* The first photo is the main image of the page: load it first. */
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : undefined}
        />
      </div>
    ))}
  </div>

  {hasThumbnails && (
    <ul class="gallery__thumbs">
      {images.map((image, index) => (
        <li>
          <button
            class="gallery__thumb"
            type="button"
            aria-label={`Show photo ${index + 1} of ${images.length}`}
            aria-current={index === 0 ? 'true' : undefined}
            data-gallery-thumb={index}
          >
            <Picture
              src={image}
              alt=""
              formats={['avif', 'webp']}
              widths={[96, 192]}
              sizes="96px"
              width={192}
              height={192}
              loading="lazy"
            />
          </button>
        </li>
      ))}
    </ul>
  )}
</div>

<script>
  import { initGalleries } from '../scripts/gallery';

  initGalleries();
</script>

<style>
  .gallery {
    display: grid;
    gap: var(--space-3);
  }

  .gallery__stage {
    aspect-ratio: 1;
    border-radius: var(--radius);
    background: var(--color-lavender-soft);
    box-shadow: var(--shadow);
  }

  .gallery__slide,
  .gallery__slide :global(picture) {
    height: 100%;
  }

  .gallery :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* With JavaScript only the active photo shows. Without it, all photos stack. */
  :global(.js) .gallery__slide:not(.is-active) {
    display: none;
  }

  :global(.no-js) .gallery__stage {
    aspect-ratio: auto;
    display: grid;
    gap: var(--space-3);
    background: transparent;
    box-shadow: none;
  }

  :global(.no-js) .gallery__thumbs {
    display: none;
  }

  .gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery__thumb {
    display: block;
    width: 72px;
    height: 72px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    background: var(--color-lavender-soft);
    overflow: hidden;
    cursor: pointer;
    transition: border-color var(--duration-hover) var(--ease);
  }

  .gallery__thumb:hover {
    border-color: var(--color-border-strong);
  }

  .gallery__thumb[aria-current='true'] {
    border-color: var(--color-crimson-deep);
  }

  @media (min-width: 600px) {
    .gallery__thumb {
      width: 88px;
      height: 88px;
    }
  }
</style>
