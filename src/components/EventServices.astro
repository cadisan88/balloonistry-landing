---
import Icon from './Icon.astro';
import { eventServices, eventTypes } from '../config/events';
---

<div class="event-services">
  <div>
    <h3>What we create</h3>
    <ul class="event-services__list">
      {eventServices.map((service) => (
        <li>
          <Icon name="check" size={20} />
          {service}
        </li>
      ))}
    </ul>
  </div>
  <div>
    <h3>For every celebration</h3>
    <ul class="event-services__types">
      {eventTypes.map((type) => (
        <li>{type}</li>
      ))}
    </ul>
  </div>
</div>

<style>
  .event-services {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }

  @media (min-width: 860px) {
    .event-services {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  .event-services ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event-services__list {
    display: grid;
    gap: var(--space-2);
  }

  .event-services__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .event-services__list :global(.icon) {
    margin-top: 0.2em;
    color: var(--color-crimson-deep);
  }

  .event-services__types {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .event-services__types li {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    font-size: var(--text-small);
    font-weight: 700;
  }
</style>
