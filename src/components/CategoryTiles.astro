---
import { Picture } from 'astro:assets';
import type { Category } from '../lib/content';

interface Props {
  categories: Category[];
  /** Sent with the `category_clicked` event. */
  location: 'home';
}

const { categories, location } = Astro.props;
---

<ul class="category-tiles">
  {categories.map((category) => (
    <li>
      <a
        class="category-tile"
        href={`/shop/${category.id}/`}
        data-category-link
        data-category={category.id}
        data-location={location}
      >
        {category.data.image ? (
          <span class="category-tile__media hover-zoom">
            <Picture
              src={category.data.image}
              alt=""
              formats={['avif', 'webp']}
              widths={[240, 400, 600]}
              sizes="(min-width: 860px) 22vw, 45vw"
              loading="lazy"
            />
          </span>
        ) : (
          <span class="category-tile__media category-tile__media--plain">
            <svg width="40" height="54" viewBox="0 0 22 30" aria-hidden="true">
              <ellipse cx="11" cy="11" rx="10" ry="11" />
              <path d="M8.5 22.5h5L11 20z" />
              <path class="category-tile__string" d="M11 23c-3 2 3 3.5 0 6" fill="none" />
            </svg>
          </span>
        )}
        <span class="category-tile__name">{category.data.name}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .category-tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 600px) {
    .category-tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  @media (min-width: 860px) {
    .category-tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .category-tile {
    position: relative;
    display: block;
    height: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--color-ink);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow var(--duration-hover) var(--ease),
      transform var(--duration-hover) var(--ease);
  }

  .category-tile:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .category-tile__media {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
  }

  .category-tile__media :global(picture),
  .category-tile__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-tile__media--plain {
    background: var(--color-lavender);
  }

  .category-tile__media--plain svg {
    fill: var(--color-white);
    transition: transform var(--duration-hover) var(--ease);
  }

  .category-tile__string {
    stroke: var(--color-crimson-deep);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .category-tile:hover .category-tile__media--plain svg {
    transform: translateY(-4px) rotate(-4deg);
  }

  /* The name sits on a solid label, so it stays readable on any photo */
  .category-tile__name {
    display: block;
    padding: var(--space-4);
    background: var(--color-white);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 600;
    line-height: 1.2;
  }

  @media (prefers-reduced-motion: reduce) {
    .category-tile:hover,
    .category-tile:hover .category-tile__media--plain svg {
      transform: none;
    }
  }
</style>
