---
import Fringe from './Fringe.astro';
import Icon from './Icon.astro';
import { site } from '../config/site';

const { address } = site;
const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <Fringe top />
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <p class="site-footer__name">{site.name}</p>
      <p class="site-footer__tagline">{site.tagline}</p>
      <ul class="site-footer__social">
        <li>
          <a href={site.social.instagram} rel="noopener" aria-label={`${site.name} on Instagram`}>
            <Icon name="instagram" size={22} />
          </a>
        </li>
        <li>
          <a href={site.social.facebook} rel="noopener" aria-label={`${site.name} on Facebook`}>
            <Icon name="facebook" size={22} />
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">Contact</h2>
      <ul class="site-footer__list">
        <li class="site-footer__with-icon">
          <Icon name="map-pin" size={18} />
          <address>
            {address.street}
            <br />
            {address.city}, {address.region}
          </address>
        </li>
        <li class="site-footer__with-icon">
          <Icon name="phone" size={18} />
          <a href={site.channels.phone} data-channel="phone" data-channel-location="footer">
            {site.phone.display}
          </a>
        </li>
        <li class="site-footer__with-icon">
          <Icon name="mail" size={18} />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">Explore</h2>
      <ul class="site-footer__list">
        {site.footer.explore.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">Policies</h2>
      <ul class="site-footer__list">
        {site.footer.policies.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="container">
    <p class="site-footer__copyright">
      &copy; {year} {site.name}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-block: calc(var(--space-8) + var(--fringe-tooth)) var(--space-5);
    background: var(--color-ink);
    color: var(--color-white);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 600px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 860px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1.2fr 0.8fr 1.2fr;
    }
  }

  .site-footer a {
    color: var(--color-white);
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }

  .site-footer__name {
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-style: italic;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    line-height: var(--leading-heading);
  }

  .site-footer__tagline {
    color: var(--color-on-dark-muted);
  }

  .site-footer__heading {
    margin-bottom: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-lavender);
  }

  .site-footer__list,
  .site-footer__social {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__list {
    display: grid;
    gap: var(--space-1);
  }

  /* Comfortable tap targets for the text links */
  .site-footer__list a {
    display: inline-block;
    padding-block: var(--space-2);
  }

  .site-footer__with-icon {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .site-footer__with-icon :global(.icon) {
    margin-top: 0.7em;
    color: var(--color-lavender);
  }

  .site-footer__with-icon address {
    padding-block: var(--space-2);
    font-style: normal;
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-3);
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 2px solid var(--color-on-dark-muted);
    border-radius: var(--radius-pill);
    transition:
      background-color var(--duration-hover) var(--ease),
      color var(--duration-hover) var(--ease);
  }

  .site-footer__social a:hover {
    background: var(--color-white);
    color: var(--color-ink);
  }

  .site-footer__copyright {
    margin: var(--space-7) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-strong);
    max-width: none;
    font-size: var(--text-small);
    color: var(--color-on-dark-muted);
  }
</style>
