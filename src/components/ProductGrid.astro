---
import ProductCard, { type ProductList } from './ProductCard.astro';
import type { Product } from '../lib/content';

interface Props {
  products: Product[];
  list: ProductList;
  heading?: 'h2' | 'h3';
  /** Card photos open the lightbox (the home page). The page must mount a Lightbox. */
  zoomable?: boolean;
}

const { products, list, heading, zoomable = false } = Astro.props;
---

<!--
  Each item carries what the Sort select needs (src/scripts/shop-sort.ts):
  data-name, data-order, data-price, data-popularity and data-added (ISO date).
-->
<ul class="product-grid" data-product-grid>
  {products.map((product, index) => (
    <li
      data-name={product.data.name}
      data-order={product.data.order}
      data-price={product.data.price}
      data-popularity={product.data.popularity}
      data-added={product.data.added?.toISOString()}
    >
      <ProductCard
        product={product}
        list={list}
        position={index + 1}
        heading={heading}
        zoomable={zoomable}
      />
    </li>
  ))}
</ul>

<style>
  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 600px) {
    .product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  @media (min-width: 860px) {
    .product-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
