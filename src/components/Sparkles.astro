---
/**
 * Decorative confetti: a small cluster of twinkling sparkles and dots.
 * Position it from the parent with the `class` prop. Hidden from assistive technology.
 */
interface Props {
  class?: string;
  /** Mirror the cluster horizontally (for the right side of a heading). */
  flip?: boolean;
}

const { class: className, flip = false } = Astro.props;
const star = 'M0-10C1-3 3-1 10 0C3 1 1 3 0 10C-1 3-3 1-10 0C-3-1-1-3 0-10Z';
---

<svg
  class:list={['sparkles', { 'sparkles--flip': flip }, className]}
  width="72"
  height="72"
  viewBox="0 0 72 72"
  aria-hidden="true"
  focusable="false"
>
  <path
    class="sparkles__item sparkles__item--orange"
    d={star}
    transform="translate(22 22) scale(1.4)"
  ></path>
  <path
    class="sparkles__item sparkles__item--turquoise"
    d={star}
    transform="translate(54 44) scale(0.9)"
  ></path>
  <path
    class="sparkles__item sparkles__item--crimson"
    d={star}
    transform="translate(18 58) scale(0.6)"
  ></path>
  <circle class="sparkles__item sparkles__item--crimson" cx="56" cy="14" r="3.5"></circle>
  <circle class="sparkles__item sparkles__item--turquoise" cx="40" cy="64" r="2.5"></circle>
</svg>

<style>
  .sparkles {
    display: block;
    overflow: visible;
    pointer-events: none;
  }

  .sparkles--flip {
    transform: scaleX(-1);
  }

  .sparkles__item {
    animation: sparkles-twinkle 2.8s ease-in-out infinite;
  }

  .sparkles__item:nth-child(2) {
    animation-delay: -0.9s;
  }

  .sparkles__item:nth-child(3) {
    animation-delay: -1.6s;
  }

  .sparkles__item:nth-child(4) {
    animation-delay: -2.2s;
  }

  .sparkles__item--orange {
    fill: var(--color-orange);
  }

  .sparkles__item--turquoise {
    fill: var(--color-turquoise);
  }

  .sparkles__item--crimson {
    fill: var(--color-crimson);
  }

  /* Opacity only: no zoom, so it is gentle even before the reduced-motion check */
  @keyframes sparkles-twinkle {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sparkles__item {
      animation: none;
    }
  }
</style>
