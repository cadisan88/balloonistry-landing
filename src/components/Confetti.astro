---
/**
 * Decorative confetti layer (styles: `.confetti` in global.css).
 * Put it inside a positioned parent. The pieces fall into place once on load, never loop,
 * and are static under prefers-reduced-motion. Hidden from assistive technology.
 *  - "frame": pieces around a framed photo (some sit outside the parent's box)
 *  - "field": pieces spread over a whole area (menu, bands)
 *
 * Positions live in the CSS below, not in style attributes: the site's CSP blocks inline styles.
 * Generated from a list of [x%, y%, rotation, colour, shape]; edit the CSS rules directly.
 */
interface Props {
  variant?: 'frame' | 'field';
  class?: string;
}

const shapes = {
  frame: [
    'bar',
    'dot',
    'wave',
    'bar',
    'bar',
    'dot',
    'bar',
    'wave',
    'dot',
    'bar',
    'dot',
    'bar',
    'wave',
    'bar',
    'dot',
    'bar',
    'dot',
    'wave',
    'bar',
    'dot',
    'bar',
    'dot',
  ],
  field: [
    'bar',
    'dot',
    'wave',
    'bar',
    'dot',
    'bar',
    'wave',
    'dot',
    'bar',
    'bar',
    'dot',
    'bar',
    'wave',
    'bar',
    'dot',
    'bar',
    'dot',
    'bar',
  ],
} as const;

const { variant = 'field', class: className } = Astro.props;
---

<div class:list={['confetti', `confetti--${variant}`, className]} aria-hidden="true">
  {shapes[variant].map((shape) => (
    <i data-s={shape === 'bar' ? undefined : shape} />
  ))}
</div>

