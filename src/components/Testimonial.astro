---
/**
 * One review: photo, quote and name. A slide of TestimonialCarousel.
 */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  testimonial: CollectionEntry<'testimonials'>;
}

const { testimonial } = Astro.props;
const { name, city, message, image } = testimonial.data;
const byline = city ? `${name}, ${city}` : name;
---

<figure class="testimonial">
  <div class="testimonial__photo">
    <Picture
      src={image}
      alt={`Photo from ${name}'s review`}
      formats={['avif', 'webp']}
      widths={[320, 480, 640]}
      sizes="(min-width: 860px) 280px, 70vw"
      loading="eager"
      decoding="async"
    />
  </div>
  <div class="testimonial__body">
    <svg class="testimonial__mark" width="56" height="44" viewBox="0 0 56 44" aria-hidden="true">
      <path d="M0 44V27C0 12 8 3 22 0l3 6C16 9 12 15 12 22h11v22H0Zm31 0V27C31 12 39 3 53 0l3 6c-9 3-13 9-13 16h11v22H31Z"></path>
    </svg>
    <blockquote>
      <p>{message}</p>
    </blockquote>
    <figcaption>{byline}</figcaption>
  </div>
</figure>

<style>
  .testimonial {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    margin: 0;
  }

  @media (min-width: 860px) {
    .testimonial {
      grid-template-columns: 17.5rem minmax(0, 1fr);
      gap: var(--space-7);
    }
  }

  .testimonial__photo {
    width: min(70%, 17.5rem);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--radius-arch);
    background: var(--color-lavender-soft);
    box-shadow: var(--shadow-sm);
  }

  .testimonial__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial__mark {
    width: 3rem;
    height: auto;
    margin-bottom: var(--space-3);
    fill: var(--color-crimson);
  }

  .testimonial blockquote {
    margin: 0;
  }

  .testimonial blockquote p {
    max-width: 28ch;
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    font-style: italic;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .testimonial figcaption {
    font-weight: 700;
    color: var(--color-crimson-deep);
  }
</style>
