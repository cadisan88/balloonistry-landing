---
import type { CollectionEntry } from 'astro:content';

interface Props {
  testimonial: CollectionEntry<'testimonials'>;
}

const { name, city, text } = Astro.props.testimonial.data;
---

<figure class="testimonial">
  <svg class="testimonial__mark" width="56" height="44" viewBox="0 0 56 44" aria-hidden="true">
    <path d="M0 44V27C0 12 8 3 22 0l3 6C16 9 12 15 12 22h11v22H0Zm31 0V27C31 12 39 3 53 0l3 6c-9 3-13 9-13 16h11v22H31Z"></path>
  </svg>
  <blockquote>
    <p>{text}</p>
  </blockquote>
  <figcaption>
    {name}, {city}
  </figcaption>
</figure>

<style>
  /* Editorial pull quote: left aligned, with the quote mark hanging in the margin */
  .testimonial {
    position: relative;
    max-width: 48rem;
    margin: 0 auto;
    padding-top: var(--space-8);
  }

  .testimonial__mark {
    position: absolute;
    top: 0;
    left: 0;
    width: 4.5rem;
    height: auto;
    fill: var(--color-crimson);
  }

  @media (min-width: 860px) {
    .testimonial {
      padding-top: 0;
    }

    .testimonial__mark {
      left: -6.5rem;
      width: 5rem;
    }
  }

  .testimonial blockquote {
    margin: 0;
  }

  .testimonial blockquote p {
    max-width: 26ch;
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-style: italic;
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.015em;
  }

  .testimonial figcaption {
    font-weight: 700;
    color: var(--color-crimson-deep);
  }
</style>
