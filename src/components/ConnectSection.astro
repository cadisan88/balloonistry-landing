---
/**
 * The ordering channels next to the contact form.
 * Used by the home page ("Connect with us") and the Contact page.
 * Channels come first (WhatsApp, Instagram, Text us, Call), the form is the secondary path.
 */
import ChannelLinks from './ChannelLinks.astro';
import ContactDetails from './ContactDetails.astro';
import ContactForm from './ContactForm.astro';

interface Props {
  /** Prefix for the form field ids. */
  idPrefix: string;
  /** Show the address, phone and email under the channels. */
  details?: boolean;
  /** Heading level for "Prefer to chat?", one below the page section heading. */
  headingLevel?: 'h2' | 'h3';
}

const { idPrefix, details = false, headingLevel: Heading = 'h3' } = Astro.props;
---

<div class="connect">
  <aside class="connect__channels" aria-labelledby={`${idPrefix}-channels-title`}>
    <Heading class="connect__title" id={`${idPrefix}-channels-title`}>
      Chat with us
    </Heading>
    <p>Message, text or call us. We are happy to help you plan your balloons.</p>
    <ChannelLinks location="contact_section" intent="contact" />
    {details && (
      <div class="connect__details">
        <Heading class="connect__title">Find us</Heading>
        <ContactDetails />
      </div>
    )}
  </aside>
  <div class="connect__form">
    <Heading class="connect__title">Or send a message</Heading>
    <ContactForm type="contact" idPrefix={idPrefix} />
  </div>
</div>

<style>
  .connect__title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-style: normal;
    letter-spacing: 0;
  }

  .connect {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }

  @media (min-width: 860px) {
    .connect {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
      gap: var(--space-8);
    }
  }

  .connect__form {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 600px) {
    .connect__form {
      padding: var(--space-6);
    }
  }

  .connect__details {
    margin-top: var(--space-7);
  }
</style>
