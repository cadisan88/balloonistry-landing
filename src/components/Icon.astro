---
/**
 * Inline SVG icon. Line icons come from Lucide, brand logos from Simple Icons.
 * Icons are decorative: the visible label or an aria-label on the parent names the control.
 */
import ArrowRight from '../assets/icons/arrow-right.svg';
import CalendarHeart from '../assets/icons/calendar-heart.svg';
import Check from '../assets/icons/check.svg';
import ChevronDown from '../assets/icons/chevron-down.svg';
import ChevronLeft from '../assets/icons/chevron-left.svg';
import ChevronRight from '../assets/icons/chevron-right.svg';
import ClipboardList from '../assets/icons/clipboard-list.svg';
import Copy from '../assets/icons/copy.svg';
import Facebook from '../assets/icons/facebook.svg';
import HeartHandshake from '../assets/icons/heart-handshake.svg';
import Instagram from '../assets/icons/instagram.svg';
import Mail from '../assets/icons/mail.svg';
import MapPin from '../assets/icons/map-pin.svg';
import Maximize2 from '../assets/icons/maximize-2.svg';
import Menu from '../assets/icons/menu.svg';
import MessageCircle from '../assets/icons/message-circle.svg';
import MessageSquareText from '../assets/icons/message-square-text.svg';
import Messenger from '../assets/icons/messenger.svg';
import Minus from '../assets/icons/minus.svg';
import Palette from '../assets/icons/palette.svg';
import Pause from '../assets/icons/pause.svg';
import Phone from '../assets/icons/phone.svg';
import Play from '../assets/icons/play.svg';
import Plus from '../assets/icons/plus.svg';
import ShoppingCart from '../assets/icons/shopping-cart.svg';
import Trash2 from '../assets/icons/trash-2.svg';
import Truck from '../assets/icons/truck.svg';
import Whatsapp from '../assets/icons/whatsapp.svg';
import X from '../assets/icons/x.svg';

const icons = {
  'arrow-right': ArrowRight,
  'calendar-heart': CalendarHeart,
  check: Check,
  'chevron-down': ChevronDown,
  'chevron-left': ChevronLeft,
  'chevron-right': ChevronRight,
  'clipboard-list': ClipboardList,
  copy: Copy,
  facebook: Facebook,
  'heart-handshake': HeartHandshake,
  instagram: Instagram,
  mail: Mail,
  'map-pin': MapPin,
  'maximize-2': Maximize2,
  menu: Menu,
  'message-circle': MessageCircle,
  'message-square-text': MessageSquareText,
  messenger: Messenger,
  minus: Minus,
  palette: Palette,
  pause: Pause,
  phone: Phone,
  play: Play,
  plus: Plus,
  'shopping-cart': ShoppingCart,
  'trash-2': Trash2,
  truck: Truck,
  whatsapp: Whatsapp,
  x: X,
};

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const Svg = icons[name];
---

<Svg width={size} height={size} class:list={['icon', className]} aria-hidden="true" />

<style is:global>
  .icon {
    flex-shrink: 0;
  }
</style>
