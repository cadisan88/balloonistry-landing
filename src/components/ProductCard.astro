---
import { Picture } from 'astro:assets';
import ProductTags from './ProductTags.astro';
import type { Product } from '../lib/content';
import { formatPrice } from '../lib/price';

export type { ProductList } from '../lib/analytics';
import type { ProductList } from '../lib/analytics';

interface Props {
  product: Product;
  list: ProductList;
  /** Position in the list, starting at 1. */
  position: number;
  /** The heading level must fit the page outline. */
  heading?: 'h2' | 'h3';
}

const { product, list, position, heading: Heading = 'h3' } = Astro.props;
const { name, price, tags, images, imageAlt } = product.data;
const [mainImage] = images;
const href = `/products/${product.id}/`;
---

<article class="product-card">
  <div class="product-card__media zoom-out">
    {mainImage && (
      <Picture
        src={mainImage}
        /* The name follows right below, so the default alt would only repeat it. */
        alt={imageAlt ?? ''}
        formats={['avif', 'webp']}
        widths={[240, 360, 480, 720]}
        sizes="(min-width: 1180px) 275px, (min-width: 860px) 24vw, (min-width: 600px) 31vw, 46vw"
        width={720}
        height={720}
        loading="lazy"
      />
    )}
    <ProductTags tags={tags} class="product-card__tags" />
  </div>
  <div class="product-card__body">
    <Heading class="product-card__name">
      <a
        class="product-card__link"
        href={href}
        data-product-card
        data-product={product.id}
        data-list={list}
        data-position={position}
      >
        {name}
      </a>
    </Heading>
    <p class="product-card__price">{formatPrice(price)}</p>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition:
      box-shadow var(--duration-hover) var(--ease),
      transform var(--duration-hover) var(--ease);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  /* The focus ring goes around the whole card */
  .product-card:has(.product-card__link:focus-visible) {
    outline: 3px solid var(--color-ink);
    outline-offset: 3px;
  }

  .product-card__link:focus-visible {
    outline: none;
  }

  .product-card__media {
    position: relative;
    aspect-ratio: 1;
    background: var(--color-lavender-soft);
  }

  .product-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-card__media :global(.product-card__tags) {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    right: var(--space-3);
  }

  .product-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
  }

  .product-card__name {
    margin: 0;
    font-size: 1.125rem;
  }

  @media (min-width: 600px) {
    .product-card__name {
      font-size: var(--text-h3);
    }
  }

  .product-card__link {
    color: var(--color-ink);
    text-decoration: none;
  }

  /* Full-card link */
  .product-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .product-card__price {
    margin: 0;
    font-weight: 700;
    color: var(--color-crimson-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card:hover {
      transform: none;
    }
  }
</style>
