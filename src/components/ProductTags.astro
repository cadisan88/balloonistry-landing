---
/** Product tags as die-cut stickers (`.sticker` in global.css). */
import type { Product } from '../lib/content';

type Tag = Product['data']['tags'][number];

interface Props {
  tags: Tag[];
  /** Adds an "Add-ons available" sticker (the product has options). */
  addons?: boolean;
  class?: string;
}

const LABELS: Record<Tag, string> = {
  new: 'New',
  'best-seller': 'Best seller',
};

const MODIFIERS: Record<Tag, string> = {
  new: '',
  'best-seller': 'sticker--crimson',
};

const { tags, addons = false, class: className } = Astro.props;
---

{(tags.length > 0 || addons) && (
  <ul class:list={['product-tags', className]}>
    {tags.map((tag) => (
      <li class:list={['sticker', MODIFIERS[tag]]}>{LABELS[tag]}</li>
    ))}
    {addons && <li class="sticker sticker--orange">Add-ons available</li>}
  </ul>
)}

<style>
  .product-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
