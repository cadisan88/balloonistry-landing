---
import type { Product } from '../lib/content';

type Tag = Product['data']['tags'][number];

interface Props {
  tags: Tag[];
  class?: string;
}

const LABELS: Record<Tag, string> = {
  new: 'New',
  'best-seller': 'Best seller',
};

const { tags, class: className } = Astro.props;
---

{tags.length > 0 && (
  <ul class:list={['product-tags', className]}>
    {tags.map((tag) => (
      <li class:list={['tag', `tag-${tag}`]}>{LABELS[tag]}</li>
    ))}
  </ul>
)}

<style>
  .product-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
