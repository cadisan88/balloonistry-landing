---
/**
 * The photo and video viewer. Mount it once per page, then give any element
 * `data-lightbox-group` to open it (see src/scripts/lightbox.ts for the attributes).
 */
import Icon from './Icon.astro';
---

<dialog class="lightbox" aria-label="Photo and video viewer" data-lightbox>
  <button class="lightbox__btn lightbox__close" type="button" data-lightbox-close>
    <Icon name="x" size={26} />
    <span class="visually-hidden">Close</span>
  </button>
  <button class="lightbox__btn lightbox__nav lightbox__prev" type="button" data-lightbox-prev>
    <Icon name="chevron-left" size={28} />
    <span class="visually-hidden">Previous</span>
  </button>
  <div class="lightbox__stage" data-lightbox-stage></div>
  <button class="lightbox__btn lightbox__nav lightbox__next" type="button" data-lightbox-next>
    <Icon name="chevron-right" size={28} />
    <span class="visually-hidden">Next</span>
  </button>
  <p class="lightbox__counter" aria-live="polite" data-lightbox-counter></p>
</dialog>

<script>
  import { initLightbox } from '../scripts/lightbox';

  initLightbox();
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-white);
    overflow: hidden;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: rgb(43 37 64 / 0.88);
  }

  /* The media area is 80% of the viewport, whatever the shape of the photo */
  .lightbox__stage {
    position: relative;
    width: 80vw;
    height: 80vh;
    height: 80dvh;
  }

  /* The media fills the box and fits inside it, whatever its shape */
  .lightbox__stage :global(img),
  .lightbox__stage :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }

  .lightbox__btn {
    position: absolute;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color var(--duration-hover) var(--ease);
  }

  .lightbox__btn:hover {
    background: var(--color-orange);
  }

  .lightbox__btn:focus-visible {
    outline-color: var(--color-white);
    outline-offset: 3px;
  }

  .lightbox__btn[hidden] {
    display: none;
  }

  .lightbox__close {
    top: var(--space-4);
    right: var(--space-4);
  }

  .lightbox__nav {
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__prev {
    left: var(--space-3);
  }

  .lightbox__next {
    right: var(--space-3);
  }

  .lightbox__counter {
    position: absolute;
    bottom: var(--space-4);
    left: 50%;
    margin: 0;
    translate: -50% 0;
    font-weight: 800;
  }

  .lightbox__counter[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] {
      animation: lightbox-in 200ms var(--ease);
    }

    @keyframes lightbox-in {
      from {
        opacity: 0;
      }
    }
  }
</style>
