---
/**
 * The photo and video viewer. Mount it once per page, then give any element
 * `data-lightbox-group` to open it (see src/scripts/lightbox.ts for the attributes).
 */
import Icon from './Icon.astro';
---

<dialog class="lightbox" aria-label="Photo and video viewer" data-lightbox>
  <button class="lightbox__btn lightbox__close" type="button" data-lightbox-close>
    <Icon name="x" size={26} />
    <span class="visually-hidden">Close</span>
  </button>
  <button class="lightbox__btn lightbox__nav lightbox__prev" type="button" data-lightbox-prev>
    <Icon name="chevron-left" size={28} />
    <span class="visually-hidden">Previous</span>
  </button>
  <div class="lightbox__stage" data-lightbox-stage></div>
  <button class="lightbox__btn lightbox__nav lightbox__next" type="button" data-lightbox-next>
    <Icon name="chevron-right" size={28} />
    <span class="visually-hidden">Next</span>
  </button>
  <p class="lightbox__counter" aria-live="polite" data-lightbox-counter></p>
</dialog>

<script>
  import { initLightbox } from '../scripts/lightbox';

  initLightbox();
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-white);
    overflow: hidden;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: rgb(43 37 64 / 0.88);
  }

  /*
   * A row of slides: the current one is centred, the neighbours peek in at the sides.
   * Each slide is moved by --lb-pos (set by the script): -1 left, 0 centre, 1 right.
   */
  .lightbox {
    --lb-w: 60vw;
    --lb-gap: 2vw;
    --lb-h: 80vh;
  }

  @supports (height: 1dvh) {
    .lightbox {
      --lb-h: 80dvh;
    }
  }

  @media (max-width: 859px) {
    .lightbox {
      --lb-w: 72vw;
    }
  }

  .lightbox__stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    touch-action: pan-y;
  }

  .lightbox :global(.lightbox__slide) {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: var(--lb-w);
    height: var(--lb-h);
    transform: translate(calc(-50% + var(--lb-pos, 0) * (var(--lb-w) + var(--lb-gap))), -50%);
    transition:
      transform var(--duration-slide) var(--ease),
      opacity var(--duration-slide) var(--ease);
  }

  .lightbox :global(.lightbox__slide.is-jump) {
    transition: none;
  }

  /* The neighbours are dimmed and can be clicked */
  .lightbox :global(.lightbox__slide.is-peek) {
    opacity: 0.5;
    cursor: pointer;
  }

  .lightbox :global(.lightbox__slide.is-far) {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* The media keeps its own shape inside the slide, in a white frame like a party photo */
  .lightbox :global(.lightbox__slide .lightbox__media) {
    display: block;
    box-sizing: border-box;
    max-width: var(--lb-w);
    max-height: var(--lb-h);
    border: 4px solid var(--color-white);
    border-radius: var(--radius);
    background: var(--color-ink);
    box-shadow: var(--shadow-lg);
    object-fit: contain;
  }

  /* A video, or a tile before it plays, fills the slide box */
  .lightbox :global(.lightbox__slide video.lightbox__media) {
    width: var(--lb-w);
    height: var(--lb-h);
  }

  .lightbox :global(.lightbox__slide div.lightbox__media) {
    width: 100%;
    height: 100%;
  }

  .lightbox :global(.lightbox__slide.is-current .lightbox__media) {
    outline: 3px solid var(--color-turquoise);
    outline-offset: 0;
  }

  .lightbox :global(.lightbox__slide img.lightbox__media) {
    user-select: none;
    -webkit-user-drag: none;
  }

  .lightbox__btn {
    position: absolute;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color var(--duration-hover) var(--ease);
  }

  .lightbox__btn:hover {
    background: var(--color-orange);
  }

  .lightbox__btn:focus-visible {
    outline-color: var(--color-white);
    outline-offset: 3px;
  }

  .lightbox__btn[hidden] {
    display: none;
  }

  .lightbox__close {
    top: var(--space-4);
    right: var(--space-4);
  }

  .lightbox__nav {
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__prev {
    left: var(--space-3);
  }

  .lightbox__next {
    right: var(--space-3);
  }

  .lightbox__counter {
    position: absolute;
    bottom: var(--space-4);
    left: 50%;
    margin: 0;
    translate: -50% 0;
    font-weight: 800;
  }

  .lightbox__counter[hidden] {
    display: none;
  }

  /* Reduced motion: the slides change place at once */
  @media (prefers-reduced-motion: reduce) {
    .lightbox :global(.lightbox__slide) {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] {
      animation: lightbox-in 200ms var(--ease);
    }

    @keyframes lightbox-in {
      from {
        opacity: 0;
      }
    }
  }
</style>
