---
/** Eyebrow, big italic H2 and an optional intro. Fades in on scroll (the only reveal on a page). */
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  align?: 'start' | 'center';
  /** Kept for older pages: every section heading is now the large display size. */
  display?: boolean;
}

const { eyebrow, title, id, align = 'start' } = Astro.props;
---

<header class:list={['section-header', 'reveal', `section-header--${align}`]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  <slot />
</header>

<style>
  .section-header {
    margin-bottom: var(--space-7);
  }

  .section-header > :global(:last-child) {
    margin-bottom: 0;
  }

  .section-header--center {
    text-align: center;
  }

  .section-header--center :global(p) {
    margin-inline: auto;
  }

  .section-header h2 {
    max-width: 18ch;
    margin-bottom: var(--space-4);
    font-size: var(--text-display-2);
    line-height: var(--leading-display);
  }

  .section-header--center h2 {
    margin-inline: auto;
  }

  .section-header :global(p:not(.eyebrow)) {
    max-width: 52ch;
    font-size: var(--text-lead);
  }
</style>
