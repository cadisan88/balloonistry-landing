---
import { Picture } from 'astro:assets';
import Icon, { type IconName } from './Icon.astro';
import Sparkles from './Sparkles.astro';
import Squiggle from './Squiggle.astro';
import heroImage from '../assets/brand/hero-talk-30.jpg';
import { site } from '../config/site';

const facts: { icon: IconName; label: string }[] = [
  { icon: 'heart-handshake', label: 'Handmade locally' },
  { icon: 'truck', label: 'Pickup & delivery' },
  { icon: 'palette', label: 'Custom colours' },
];

// Floating balloons around the arch (decorative)
const balloons = ['crimson', 'turquoise', 'orange'] as const;

// The tagline with its last word underlined by the hand-drawn squiggle
const match = /^(.*\s)(\S+?)([.!?]*)$/.exec(site.tagline);
const [lead, word, end] = match ? [match[1], match[2], match[3]] : [site.tagline, '', ''];
---

<section class="hero band band--cream" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__text">
      <h1 class="hero__kicker enter">
        Custom Balloon Gifts &amp; Event Decor | Kitchener, Waterloo, Cambridge
      </h1>
      <h2 id="hero-title" class="hero__title enter enter-d1">
        {lead}
        {word ? <Squiggle>{word}</Squiggle> : null}
        {end}
      </h2>
      <p class="hero__lead enter enter-d2">
        Welcome to Balloonistry, where every balloon tells a story. Explore our collection of custom
        bobo balloon gifts, helium balloons, surprises, and more, perfect for all occasions.
      </p>
      <div class="btn-row enter enter-d3">
        <a class="btn btn-primary" href="/shop/">
          Browse balloons
        </a>
        <a class="btn btn-secondary" href="/events/">
          Plan an event
        </a>
      </div>
      <ul class="hero__facts enter enter-d4">
        {facts.map((fact) => (
          <li>
            <Icon name={fact.icon} size={20} />
            {fact.label}
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__frame">
      <div class="hero__media enter-scale enter-d2">
        <Picture
          src={heroImage}
          alt="Red, blush and white balloon arch around a sign that reads Talk Thirty to Me"
          formats={['avif', 'webp']}
          widths={[400, 600, 800, 1200]}
          sizes="(min-width: 1180px) 440px, (min-width: 860px) 38vw, 80vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="hero__balloons" aria-hidden="true">
        {balloons.map((colour, index) => (
          <span class:list={['hero__balloon', `hero__balloon--${index + 1}`]}>
            <span class:list={['hero__balloon-body', `hero__balloon-body--${colour}`]} />
          </span>
        ))}
      </div>
      <Sparkles class="hero__sparkles" />
    </div>
  </div>
</section>

<style>
  .hero {
    /* The balloons float past the frame on phones: never scroll sideways */
    overflow-x: clip;
    padding-block: var(--space-7) calc(var(--section-pad) + var(--fringe-tooth));
  }

  @media (min-width: 860px) {
    .hero {
      padding-top: var(--space-8);
    }
  }

  .hero__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 860px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      gap: var(--space-7);
    }
  }

  /* ----- Text: a huge, tight italic headline, left aligned ----- */

  /* The page's h1: a small, prominent sentence above the big tagline */
  .hero__kicker {
    max-width: 36ch;
    margin: 0 0 var(--space-4);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.4;
    color: var(--color-ink);
  }

  @media (min-width: 860px) {
    .hero__kicker {
      font-size: 1.125rem;
    }
  }

  .hero__title {
    max-width: 11ch;
    margin-bottom: var(--space-6);
    font-size: var(--text-display-1);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .hero__lead {
    max-width: 46ch;
    margin-bottom: var(--space-6);
    font-size: var(--text-lead);
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
    font-weight: 700;
  }

  .hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero__facts :global(.icon) {
    color: var(--color-crimson-deep);
  }

  /* ----- Photo: an arch with a lavender paper arch tucked behind it ----- */

  .hero__frame {
    position: relative;
    width: min(100%, 26rem);
    margin-inline: auto;
    margin-bottom: var(--space-5);
  }

  .hero__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-arch);
    background: var(--color-lavender);
    transform: translate(var(--space-5), var(--space-5)) rotate(3deg);
  }

  .hero__media {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-arch);
    background: var(--color-lavender-soft);
    box-shadow: var(--shadow-lg);
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__frame :global(.hero__sparkles) {
    position: absolute;
    z-index: 2;
    top: 6%;
    left: -2.25rem;
    width: 3.5rem;
    height: 3.5rem;
  }

  /* ----- Floating balloons: they pop in with a spring, then bob gently ----- */

  .hero__balloons {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .hero__balloon {
    position: absolute;
    display: block;
    animation: balloon-pop 0.9s var(--ease-spring) both;
  }

  .hero__balloon--1 {
    top: -1.5rem;
    right: -0.75rem;
    width: 4.25rem;
    animation-delay: 0.3s;
  }

  .hero__balloon--2 {
    top: 38%;
    right: -2.25rem;
    width: 3rem;
    animation-delay: 0.45s;
  }

  .hero__balloon--3 {
    bottom: 12%;
    left: -1.75rem;
    width: 3.5rem;
    animation-delay: 0.6s;
  }

  .hero__balloon-body {
    position: relative;
    display: block;
    aspect-ratio: 5 / 6;
    border-radius: 50% 50% 48% 48% / 56% 56% 44% 44%;
    box-shadow: inset -0.4rem -0.5rem 0 color-mix(in srgb, var(--color-ink) 12%, transparent);
    animation: balloon-bob 3.4s var(--ease-spring) infinite alternate;
  }

  /* Highlight: the shiny spot that makes it look like a real balloon */
  .hero__balloon-body::before {
    content: '';
    position: absolute;
    top: 16%;
    left: 22%;
    width: 22%;
    height: 16%;
    border-radius: 50%;
    background: var(--color-white);
    opacity: 0.55;
    transform: rotate(-30deg);
  }

  /* String */
  .hero__balloon-body::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    width: 1px;
    height: 120%;
    background: var(--color-border-strong);
  }

  .hero__balloon--2 .hero__balloon-body {
    animation-delay: -1.2s;
  }

  .hero__balloon--3 .hero__balloon-body {
    animation-delay: -2.1s;
  }

  .hero__balloon-body--crimson {
    background: var(--color-crimson);
  }

  .hero__balloon-body--turquoise {
    background: var(--color-turquoise);
  }

  .hero__balloon-body--orange {
    background: var(--color-orange);
  }

  @keyframes balloon-pop {
    from {
      opacity: 0;
      transform: translateY(1.5rem) scale(0.6);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes balloon-bob {
    from {
      transform: translateY(0) rotate(-4deg);
    }

    to {
      transform: translateY(-0.875rem) rotate(4deg);
    }
  }

  /* No pop, bob or float: the balloons just stand there */
  @media (prefers-reduced-motion: reduce) {
    .hero__balloon,
    .hero__balloon-body {
      animation: none;
    }
  }
</style>
