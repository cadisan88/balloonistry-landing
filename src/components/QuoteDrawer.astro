---
/**
 * The quote list drawer. Mount it once, in BaseLayout. Any `[data-quote-open]` opens it.
 * Behaviour: src/scripts/quote-drawer.ts. The list itself: src/scripts/quote.ts.
 * The optional fields stay in the browser: they are never sent anywhere, and never in analytics.
 */
import Icon from './Icon.astro';
import { site } from '../config/site';
import { channelLinks } from '../lib/channels';

// Placeholder links: the script fills in the message when the drawer opens
const links = channelLinks('');
---

<dialog class="drawer" aria-labelledby="quote-drawer-title" data-drawer>
  <div class="drawer__panel">
    <div class="drawer__head">
      <h2 class="drawer__title" id="quote-drawer-title" tabindex="-1" data-drawer-title>
        Your quote list
      </h2>
      <button class="drawer__close" type="button" data-drawer-close>
        <Icon name="x" size={24} />
        <span class="visually-hidden">Close quote list</span>
      </button>
    </div>

    <div class="drawer__empty" data-drawer-empty hidden>
      <p class="drawer__empty-title">Your quote list is empty</p>
      <p>Add the balloons you love, then send us the list.</p>
      <a class="btn btn-primary" href="/shop/">
        Browse balloons
      </a>
    </div>

    <div class="drawer__filled" data-drawer-filled hidden>
      <ul class="drawer__items" data-drawer-items></ul>

      <div class="drawer__total">
        <p class="drawer__total-line" data-drawer-total-line hidden>
          Estimated from <strong data-drawer-total></strong>
        </p>
        <p class="drawer__note">Final price confirmed in your quote.</p>
      </div>

      <fieldset class="drawer__details">
        <legend>Details (optional)</legend>
        <div class="drawer__field">
          <label for="quote-date">Event date</label>
          <input id="quote-date" type="date" autocomplete="off" data-detail="date" />
        </div>
        <fieldset class="drawer__radios">
          <legend>Pickup or delivery</legend>
          <label class="drawer__radio">
            <input type="radio" name="quote-delivery" value="pickup" data-detail="delivery" />
            Pickup
          </label>
          <label class="drawer__radio">
            <input type="radio" name="quote-delivery" value="delivery" data-detail="delivery" />
            Delivery
          </label>
        </fieldset>
        <div class="drawer__field" data-detail-city-field hidden>
          <label for="quote-city">Delivery Address and City</label>
          <input
            id="quote-city"
            type="text"
            maxlength="80"
            autocomplete="address-level2"
            data-detail="city"
          />
        </div>
        <div class="drawer__field">
          <label for="quote-notes">Notes</label>
          <textarea id="quote-notes" rows="3" maxlength="500" data-detail="notes"></textarea>
        </div>
      </fieldset>

      <div class="drawer__field">
        <label for="quote-message">Message preview</label>
        <textarea id="quote-message" rows="9" readonly data-drawer-message></textarea>
      </div>

      <div class="drawer__send">
        <h3 class="drawer__send-title">Send your list</h3>
        <ul class="drawer__channels">
          <li>
            <a
              class="btn btn-channel btn-channel--whatsapp btn-channel--primary"
              href={links.whatsapp}
              target="_blank"
              rel="noopener"
              data-channel="whatsapp"
              data-channel-location="quote_drawer"
              data-quote-send
              data-link="whatsapp"
            >
              <Icon name="whatsapp" size={24} />
              WhatsApp
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a
              class="btn btn-channel btn-channel--instagram"
              href={links.instagram}
              target="_blank"
              rel="noopener"
              data-channel="instagram"
              data-channel-location="quote_drawer"
              data-quote-send
              data-link="instagram"
              data-copy-message=""
            >
              <Icon name="instagram" size={24} />
              Instagram
              <span class="visually-hidden">(copies the list, opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a
              class="btn btn-channel btn-channel--sms"
              href={links.sms}
              data-channel="sms"
              data-channel-location="quote_drawer"
              data-quote-send
              data-link="sms"
            >
              <Icon name="message-square-text" size={24} />
              Text us
            </a>
          </li>
          <li>
            <a
              class="btn btn-channel btn-channel--phone"
              href={site.channels.phone}
              data-channel="phone"
              data-channel-location="quote_drawer"
              data-quote-send
              data-link="phone"
            >
              <Icon name="phone" size={24} />
              Call
            </a>
          </li>
        </ul>
        <button class="btn btn-secondary drawer__copy" type="button" data-drawer-copy>
          <Icon name="copy" size={20} />
          Copy list
        </button>
      </div>
    </div>
  </div>

  <template data-drawer-item-template>
    <li class="drawer-item" data-item>
      <img class="drawer-item__image" alt="" width="72" height="72" data-item-image />
      <div class="drawer-item__info">
        <a class="drawer-item__name link-draw" href="/" data-item-name></a>
        <ul class="drawer-item__options" data-item-options></ul>
        <p class="drawer-item__price" data-item-price></p>
        <div class="drawer-item__controls">
          <div class="stepper" role="group" data-item-stepper>
            <button class="stepper__btn" type="button" data-action="dec">
              <Icon name="minus" size={18} />
            </button>
            <input
              class="stepper__input"
              type="number"
              min="1"
              max="20"
              inputmode="numeric"
              data-action="qty"
            />
            <button class="stepper__btn" type="button" data-action="inc">
              <Icon name="plus" size={18} />
            </button>
          </div>
          <button class="drawer-item__remove" type="button" data-action="remove">
            <Icon name="trash-2" size={18} />
            Remove
          </button>
        </div>
      </div>
    </li>
  </template>
</dialog>

<script>
  import { initQuoteDrawer } from '../scripts/quote-drawer';

  initQuoteDrawer();
</script>

<style>
  .drawer {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    overflow: hidden;
  }

  .drawer::backdrop {
    background: rgb(43 37 64 / 0.55);
  }

  /* From the right. Full screen under 600px. */
  .drawer__panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    margin-left: auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-cream);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 600px) {
    .drawer__panel {
      width: 30rem;
      border-radius: var(--radius-lg) 0 0 var(--radius-lg);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawer[open] .drawer__panel {
      animation: drawer-in 300ms var(--ease);
    }

    @keyframes drawer-in {
      from {
        transform: translateX(100%);
      }
    }
  }

  .drawer__head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-hairline);
    background: var(--color-cream);
  }

  .drawer__title {
    margin: 0;
    font-size: 1.75rem;
  }

  .drawer__title:focus {
    outline: none;
  }

  .drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .drawer__close:hover {
    background: var(--color-lavender-soft);
  }

  .drawer__empty,
  .drawer__filled {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
  }

  .drawer__empty[hidden],
  .drawer__filled[hidden] {
    display: none;
  }

  .drawer__empty {
    justify-items: start;
    gap: var(--space-3);
  }

  .drawer__empty p {
    margin: 0;
  }

  .drawer__empty .btn {
    margin-top: var(--space-3);
  }

  .drawer__empty-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
  }

  /* ----- Items (built from the template by the script) ----- */

  .drawer__items {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .drawer__items :global(.drawer-item) {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .drawer__items :global(.drawer-item__image) {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-sm);
    background: var(--color-lavender-soft);
    object-fit: cover;
  }

  .drawer__items :global(.drawer-item__image[hidden]) {
    display: none;
  }

  .drawer__items :global(.drawer-item__info) {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .drawer__items :global(.drawer-item__name) {
    justify-self: start;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .drawer__items :global(.drawer-item__options) {
    margin: 0;
    padding: 0;
    font-size: var(--text-small);
    list-style: none;
  }

  .drawer__items :global(.drawer-item__options:empty) {
    display: none;
  }

  .drawer__items :global(.drawer-item__price) {
    margin: 0;
    color: var(--color-crimson-deep);
    font-weight: 700;
  }

  .drawer__items :global(.drawer-item__controls) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .drawer__items :global(.drawer-item__remove) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    font-size: var(--text-small);
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }

  .drawer__items :global(.drawer-item__remove:hover) {
    background: var(--color-lavender-soft);
  }

  /* ----- Total ----- */

  .drawer__total {
    display: grid;
    gap: var(--space-1);
  }

  .drawer__total p {
    margin: 0;
  }

  .drawer__total-line {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .drawer__total-line[hidden] {
    display: none;
  }

  .drawer__note {
    font-size: var(--text-small);
  }

  /* ----- Optional details ----- */

  .drawer__details {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-4);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
  }

  .drawer__details legend {
    padding-inline: var(--space-2);
    font-weight: 800;
  }

  .drawer__field {
    display: grid;
    gap: var(--space-1);
  }

  .drawer__field[hidden] {
    display: none;
  }

  .drawer__field label,
  .drawer__radios legend {
    font-size: var(--text-small);
    font-weight: 700;
  }

  .drawer__field input,
  .drawer__field textarea {
    width: 100%;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-white);
  }

  .drawer__field textarea {
    resize: vertical;
  }

  /* The preview is read-only: a quieter ground says so */
  .drawer__field textarea[readonly] {
    background: var(--color-lavender-soft);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .drawer__radios {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .drawer__radios legend {
    width: 100%;
    padding: 0;
    margin-bottom: var(--space-1);
  }

  .drawer__radio {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-weight: 700;
    cursor: pointer;
  }

  .drawer__radio input {
    width: 22px;
    height: 22px;
    accent-color: var(--color-ink);
  }

  /* ----- Channels ----- */

  .drawer__send {
    display: grid;
    gap: var(--space-3);
  }

  .drawer__send-title {
    margin: 0;
    font-size: var(--text-h3);
    font-style: normal;
  }

  .drawer__channels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .drawer__channels .btn {
    width: 100%;
  }

  .drawer__copy {
    justify-self: start;
  }
</style>
