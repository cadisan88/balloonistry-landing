# Copy this file to .dev.vars for local development. Never commit .dev.vars.

# Cloudflare Turnstile official test secret (always passes).
# The "always fails" test secret is 2x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional Telegram notification. Leave empty to turn it off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Allow the local dev servers to post to /api/contact.
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:8787
